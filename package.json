{
  "name": "crossword-app",
  "version": "1.0.0",
  "description": "Private legacy continuity bridge for Crossword",
  "private": true,
  "workspaces": [
    "packages/application",
    "packages/domain",
    "packages/persistence"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "test": "jest",
    "build": "node scripts/build-legacy-assets.mjs",
    "legacy:assets": "node scripts/build-legacy-assets.mjs",
    "web:dev": "make run",
    "web:build": "npm run build",
    "web:test": "npm test -- --runInBand",
    "scan:content": "node scripts/scan-forbidden-content.mjs",
    "test:mutation": "npm --prefix ../crossword-generator run test:mutation",
    "test:generator": "npm --prefix ../crossword-generator test"
  },
  "devDependencies": {
    "axios": "1.13.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "socket.io-client": "4.8.3",
    "vue": "2.7.16"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "verbose": true,
    "moduleDirectories": [
      "node_modules",
      "src/crossword/static"
    ],
    "testPathIgnorePatterns": [
      "/apps/",
      "/packages/"
    ]
  },
  "dependencies": {
    "@crossword/construction": "file:vendor/generator/crossword-construction-0.1.0.tgz",
    "@crossword/generator": "file:vendor/generator/crossword-generator-0.1.0.tgz",
    "@crossword/model-runtime": "file:vendor/generator/crossword-model-runtime-0.1.0.tgz"
  }
}
