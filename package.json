{
  "name": "crossword-app",
  "version": "1.0.0",
  "description": "Private legacy continuity bridge for Crossword",
  "private": true,
  "workspaces": [
    "apps/react",
    "packages/application",
    "packages/domain",
    "packages/persistence"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "test": "jest",
    "build": "node scripts/build-legacy-assets.mjs",
    "legacy:assets": "node scripts/build-legacy-assets.mjs",
    "web:dev": "make run",
    "web:build": "npm run build",
    "web:test": "npm test -- --runInBand",
    "scan:content": "node scripts/scan-forbidden-content.mjs",
    "test:coverage": "vitest run --config vitest.ci.config.mjs --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "test:generator": "npm --prefix ../crossword-generator test",
    "typecheck": "tsc -p tsconfig.ci.json && tsc -p apps/react/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e && npm run test:mutation"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.0",
    "@stryker-mutator/core": "9.1.1",
    "@stryker-mutator/vitest-runner": "9.1.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "3.2.4",
    "axios": "1.13.2",
    "eslint": "9.36.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.4.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.6.2",
    "socket.io-client": "4.8.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4",
    "vue": "2.7.16"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "verbose": true,
    "moduleDirectories": [
      "node_modules",
      "src/crossword/static"
    ],
    "testPathIgnorePatterns": [
      "/apps/",
      "/packages/",
      "/tests/e2e/"
    ]
  },
  "dependencies": {
    "@crossword/construction": "file:vendor/generator/crossword-construction-0.1.0.tgz",
    "@crossword/generator": "file:vendor/generator/crossword-generator-0.1.0.tgz",
    "@crossword/model-runtime": "file:vendor/generator/crossword-model-runtime-0.1.0.tgz"
  }
}
