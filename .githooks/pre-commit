#!/bin/sh
# Commit-time quality gate: nothing red gets committed.
# Static checks only (fast); the full test suites run in pre-push.
set -eu

cd "$(git rev-parse --show-toplevel)"

echo '[pre-commit] regenerating repository map…'
bash .scripts/generate-repo-map.sh
git add docs/REPO_MAP.md

echo '[pre-commit] ruff…'
uv run --no-sync ruff check .

echo '[pre-commit] prettier…'
npx --no-install prettier --check .

echo '[pre-commit] eslint…'
npm run lint --silent

echo '[pre-commit] typecheck…'
npm run typecheck --silent

echo '[pre-commit] all static gates passed.'
